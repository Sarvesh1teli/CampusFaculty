{
  "name": "campusfaculty",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test": "npm run test -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "test:browser": "node scripts/browser-check.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.20.0"
  }
}
